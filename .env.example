# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (Project Settings > Data API e Project Settings > API Keys).
#
# .env.local NÃO vai para o GitHub — ele está no .gitignore.

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-publishable

# Chave PÚBLICA do par VAPID usado pra Web Push (notificação em segundo
# plano). Segura pra expor no frontend — o par completo, com a chave
# PRIVADA, fica só como secret do Supabase Edge Function que envia o push,
# nunca aqui. Sem essa variável, o botão "Ativar notificações" volta pro
# modo antigo (só dispara com a aba aberta).
VITE_VAPID_PUBLIC_KEY=

# DSN do projeto no Sentry (sentry.io → criar projeto React → Settings →
# Client Keys/DSN). É uma URL pública, segura pra expor no frontend. Sem
# essa variável, o app roda normal e Sentry simplesmente não é inicializado
# — nenhum erro é capturado.
VITE_SENTRY_DSN=

# Site key do Cloudflare Turnstile (dash.cloudflare.com → Turnstile →
# Add site → modo "Managed"). Pública, segura pra expor. A secret key NÃO
# entra aqui — fica só no backend que valida o token (ver
# supabase/functions/verify-turnstile/). Sem essa variável, o captcha não
# aparece nos formulários e eles funcionam como hoje, sem essa camada extra.
VITE_TURNSTILE_SITE_KEY=
