# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (Project Settings > Data API e Project Settings > API Keys).
#
# .env.local NÃO vai para o GitHub — ele está no .gitignore.

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-publishable

# Chave PÚBLICA do par VAPID usado pra Web Push (notificação em segundo
# plano). Segura pra expor no frontend — o par completo, com a chave
# PRIVADA, fica só como secret do Supabase Edge Function que envia o push,
# nunca aqui. Sem essa variável, o botão "Ativar notificações" volta pro
# modo antigo (só dispara com a aba aberta).
VITE_VAPID_PUBLIC_KEY=
